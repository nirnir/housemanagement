# Copy to `.env` and fill in. Never commit `.env`.
# Values are read from the environment at call time and are never persisted,
# logged, or sent to the status UI.

# ---------------------------------------------------------------- application
PORT=4500
DATABASE_PATH=./data/housemanagement.db
PROPERTY_ID=prop-harbour

# Tenant API keys, formatted `key:tenantId` and comma-separated.
# These authenticate both the booking webhook and the operator UI.
TENANT_API_KEYS=dev-acme-key:tenant-acme,dev-other-key:tenant-other

# --------------------------------------------------------- channel endpoints
# Leave the *_API_BASE_URL variables UNSET to route through the local
# conformance server, which speaks each platform's modelled contract.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ CONTINUATION CHECKPOINT — what is still required for a live channel     │
# │                                                                         │
# │ Availability writes on Airbnb, Booking.com and Vrbo are gated behind    │
# │ partner-programme approval that this repository cannot create. For each │
# │ channel you want live, you need:                                        │
# │   1. partner / connectivity-programme approval for the account,         │
# │   2. a production (or sandbox) credential for the variable below,       │
# │   3. the published API contract, to confirm the checkout-night policy   │
# │      and booking-type mapping in src/config/channels.ts.                │
# │ Once all three are in hand, set that channel's *_API_BASE_URL. No other │
# │ code change is needed to go live.                                       │
# └─────────────────────────────────────────────────────────────────────────┘

CONFORMANCE_PORT=4599
CONFORMANCE_BASE_URL=http://127.0.0.1:4599

# Airbnb — requires Airbnb partner API access.
# AIRBNB_API_BASE_URL=
AIRBNB_API_TOKEN=dev-airbnb-token

# Booking.com — requires Connectivity Partner Programme certification.
# BOOKING_COM_API_BASE_URL=
BOOKING_COM_API_TOKEN=dev-booking-token

# Vrbo — requires Vrbo/Expedia partner access.
# VRBO_API_BASE_URL=
VRBO_API_TOKEN=dev-vrbo-token

# Home-exchange platform — the specific platform was not named in the spec.
# HOMEEXCHANGE_API_BASE_URL=
HOMEEXCHANGE_API_TOKEN=dev-homeexchange-token
